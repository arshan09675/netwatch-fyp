# ============================================================
# NetWatch - environment template  (COMMIT this file, NOT .env)
# Copy to .env and fill in your real password.
# ============================================================

# Master switch:
#   true  -> store everything in Supabase / PostgreSQL (cloud)
#   false -> use local SQLite (offline demo, zero setup)
USE_SUPABASE=true

# ---- OPTION A (RECOMMENDED): component vars ----------------
# Password is passed to the driver RAW, so a '@' or any special
# character needs NO URL-encoding. Just paste it as-is.
SUPABASE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.ujfhpxxxkilnrizrbfke
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=YOUR_PASSWORD_HERE

# ---- OPTION B: single connection string -------------------
# If set, this WINS over the component vars above. The password
# inside the URL MUST be URL-encoded (e.g. '@' -> %40).
# DATABASE_URL=postgresql://postgres.ujfhpxxxkilnrizrbfke:URL_ENCODED_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ---- Optional: default admin (first run only) -------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ChangeMe@123
# ADMIN_EMAIL=admin@netwatch.com
